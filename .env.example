# Local quickstart: copy to .env.local and run python run.py --env local.
# Hosted: set these through your deployment configuration and secret manager.
APP_ENV=local
APP_URL=http://127.0.0.1:5000
USE_FIRESTORE=false
SECRET_KEY=
# Optional separate secret for persisted CMS credentials. Keep its value stable.
CMS_ENCRYPTION_KEY=

# A contributor-owned Cloudflare Worker. Match the two secrets in .dev.vars.
LMS_WORKER_ORIGIN=http://127.0.0.1:8787
LMS_WORKER_PROXY_KEY=
DOWNLOAD_ENCRYPTION_KEY=
ZIP_NATIVE_DOWNLOADS=true

# Optional additional hosted providers. The corresponding function uses
# LMS_PROXY_SERVICE_KEY with the value below.
LMS_SUPABASE_ORIGIN=
LMS_SUPABASE_PROXY_KEY=
LMS_NETLIFY_ORIGIN=
LMS_NETLIFY_PROXY_KEY=
LMS_VERCEL_ORIGIN=
LMS_VERCEL_PROXY_KEY=
LMS_VAL_TOWN_ORIGIN=
LMS_VAL_TOWN_PROXY_KEY=

# Turnstile test pair for localhost or your own widget for a hosted site.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Hosted Firestore and optional browser push.
FIREBASE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/this/repo.json
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=
COST_SAFETY_ENABLED=false

# Optional integrations.
SCHEDULER_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_GUILD_ID=
DISCORD_LOG_WEBHOOK_URL=
DISCORD_AUTHORIZED_ROLE_ID=
GA4_MEASUREMENT_ID=
GA4_USER_ID_SECRET=

# Optional assignment connector and separate testing probe.
LMS_MCP_ENABLED=false
LMS_MCP_ALLOWED_ACCOUNTS=
LMS_MCP_DOWNLOAD_KEY=
LMS_MCP_WORKER_URL=
LMS_MCP_PROXY_HOSTS=
LMS_MCP_RAM_DIR=
LMS_MCP_PROBE_ENABLED=false
LMS_MCP_PROBE_TOKEN=
LMS_MCP_PROBE_ENCRYPTION_KEY=
LMS_MCP_PROBE_WORKER_URL=
LMS_MCP_PROBE_PROXY_HOSTS=
